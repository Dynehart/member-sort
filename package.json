{
    "name": "eslint-plugin-member-sort",
    "version": "0.1.2",
    "description": "An ESLint rule to reorder class members",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",

    "license": "MIT",
    "author": "dynehart",
    "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
    "bugs": {
        "url": "https://github.com/dynehart/member-sort/issues"
    },
    "homepage": "https://github.com/dynehart/member-sort#readme",

    "scripts": {
        "build": "tsdown",
        "lint": "eslint . --ext .ts",
        "dev": "tsdown --watch",
        "test": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "typescript",
        "class",
        "sort",
        "members",
        "rule"
    ],
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/node": "^24.7.2",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@typescript-eslint/rule-tester": "^8.46.2",
        "@typescript-eslint/utils": "^8.46.2",
        "bumpp": "^10.3.1",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.3.9",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-sort": "^4.0.0",
        "tsdown": "^0.15.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "eslint": "^9.35.0",
        "typescript": ">=4.0.0"
    },
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "eslintConfig": {
        "root": true,
        "parser": "@typescript-eslint/parser",
        "plugins": [
            "sort-member"
        ],
        "rules": {
            "sort-member/sort-member": "error"
        }
    }
}
