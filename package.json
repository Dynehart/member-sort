{
    "name": "eslint-plugin-member-sort",
    "version": "0.1.0",
    "description": "An ESLint rule to reorder TypeScript class members",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsdown  && pnpm link --global",
        "build2": "./node_modules/.bin/tsdown && pnpm link --global",
        "lint": "eslint . --ext .ts",
        "dev": "tsdown --watch",
        "test": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "typescript",
        "class",
        "sort",
        "members",
        "rule"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "@typescript-eslint/utils": "^8.45.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@types/node": "^24.7.2",
        "bumpp": "^10.3.1",
        "eslint": "^8.0.0",
        "tsdown": "^0.15.8",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "eslint": "^8.0.0",
        "typescript": ">=4.0.0"
    },
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "eslintConfig": {
        "root": true,
        "parser": "@typescript-eslint/parser",
        "plugins": [
            "sort-member"
        ],
        "rules": {
            "sort-member/sort-member": "error"
        }
    }
}
